<!--- KoldFusion Demo Gallery companion (not from Rosetta Code).
      100_doors_cfscript_fragment.cfm is the bare CFScript body exactly as it
      appears on Rosetta Code - no <cfscript> wrapper, so on its own it just
      prints as text. This runner reads the fragment with CFFILE, wraps it in
      CFSCRIPT tags, writes the result to _wrapped_100_doors.cfm and CFINCLUDEs
      it. The original file is never modified. --->
<cfset fragPath = GetDirectoryFromPath(GetCurrentTemplatePath()) & "100_doors_cfscript_fragment.cfm">
<cfset wrapPath = GetDirectoryFromPath(GetCurrentTemplatePath()) & "_wrapped_100_doors.cfm">
<cffile action="read" file="#fragPath#" variable="fragment">
<cfset wrapped = "<!--- generated by run_100_doors_cfscript.cfm - do not edit --->" & Chr(10)
	& "<cfscript>" & Chr(10) & fragment & Chr(10) & "</cfscript>" & Chr(10)>
<cffile action="write" file="#wrapPath#" output="#wrapped#" addnewline="No">
<cfinclude template="_wrapped_100_doors.cfm">
<html>
<head><title>100 Doors (CFScript)</title></head>
<body bgcolor="#FFFFFF">
<font face="Arial, Helvetica" size="2">
<h2>100 Doors - Rosetta Code CFScript solution</h2>
<p>1 = open, 0 = closed. The doors left open should be the perfect squares.</p>
<table border="1" cellpadding="3" cellspacing="0">
<cfoutput>
<cfloop from="0" to="9" index="row">
	<tr>
	<cfloop from="1" to="10" index="col">
		<cfset d = row * 10 + col>
		<cfif ListGetAt(doorList, d) EQ 1>
			<td bgcolor="##FFCC00" align="center"><b>#d#</b></td>
		<cfelse>
			<td bgcolor="##666666" align="center"><font color="##CCCCCC">#d#</font></td>
		</cfif>
	</cfloop>
	</tr>
</cfloop>
</cfoutput>
</table>
<p><b>Raw doorList:</b> <tt><cfoutput>#doorList#</cfoutput></tt></p>
</font>
</body>
</html>
